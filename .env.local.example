# Azure AD Service Principal Credentials
# For local development only - DO NOT commit .env.local to git

# Copy this file to .env.local and fill in real values
# The embed_token.py script will read these values if present

# Application (client) ID from Azure AD app registration
export PBI_CLIENT_ID="60462dce-e375-46f2-b1de-911183435c2d"

# Client secret VALUE (not ID) - keep this secure!
export PBI_CLIENT_SECRET="YOUR_SECRET_VALUE_HERE"

# Azure AD tenant ID
export PBI_TENANT_ID="b7e47691-9726-4f67-a302-e567815f3522"

# Power BI API scope (usually doesn't change)
export PBI_SCOPE="https://analysis.windows.net/.default"
